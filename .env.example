# AI Phishing Guard - backend configuration (read from the process environment).
# Copy the values you need into your shell or Docker run command.

# Address and port the Flask API listens on. Keep it on loopback.
AIPHISH_HOST=127.0.0.1
AIPHISH_PORT=5000

# Optional: path to a different trained model file.
# AIPHISH_MODEL_PATH=ml/model/phishing_model.pkl

# Optional: allow domain-age (RDAP) and TLS certificate lookups.
# Hostnames are sent to a public registry and to the site itself, so this is
# off by default. The extension must also enable it in Settings.
# AIPHISH_ENABLE_INTEL=1
